{
  "name": "@eternasuno/better-auth-acebase",
  "version": "0.1.1",
  "description": "AceBase adapter for better-auth",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "main": "./dist/adapter.js",
  "types": "./dist/adapter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eternasuno/better-auth-acebase.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "acebase": "^1.29.13",
    "better-auth": "^1.6.23"
  },
  "devDependencies": {
    "@better-auth/test-utils": "^1.6.23",
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && biome check --write",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  }
}
